{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bix.dasig.org/v0.1/Invitation.schema.json",
  "title": "BIX v0.1 Invitation",
  "x-bix-cae-kind": "Instrument",
  "type": "object",
  "allOf": [
    {
      "$ref": "datatypes.schema.json#/$defs/Resource"
    }
  ],
  "properties": {
    "resourceType": {
      "const": "Invitation"
    },
    "id": true,
    "meta": true,
    "identifier": true,
    "sharing": true,
    "language": true,
    "extension": true,
    "target": {
      "$ref": "datatypes.schema.json#/$defs/Reference"
    },
    "invitedBy": {
      "$ref": "datatypes.schema.json#/$defs/Reference"
    },
    "invitee": {
      "$ref": "datatypes.schema.json#/$defs/Reference"
    },
    "role": {
      "enum": [
        "volunteer",
        "member",
        "team-member",
        "helper"
      ]
    },
    "status": {
      "enum": [
        "sent",
        "accepted",
        "declined",
        "expired",
        "withdrawn"
      ]
    },
    "expires": {
      "$ref": "datatypes.schema.json#/$defs/dateTime"
    },
    "message": {
      "type": "string",
      "maxLength": 280
    },
    "via": {
      "enum": [
        "username",
        "email",
        "in-app"
      ]
    },
    "blockFuture": {
      "type": "boolean"
    }
  },
  "required": [
    "resourceType",
    "id",
    "meta",
    "target",
    "invitedBy",
    "role",
    "status",
    "via"
  ],
  "additionalProperties": false
}
