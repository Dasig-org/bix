{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bix.dasig.org/v0.1/datatypes.schema.json",
  "title": "BIX v0.1 data types",
  "description": "Shared data types. Domain in $id is provisional until the BIX site exists.",
  "$defs": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Assigned where the record is created, including offline. Never reused."
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 with an offset, e.g. 2026-11-08T09:00:00+08:00."
    },
    "Reference": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "description": "{Type}/{id}, or a full URL on another BIX server."
        },
        "display": {
          "type": "string"
        }
      },
      "required": [
        "reference"
      ],
      "additionalProperties": false
    },
    "Coding": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^(bayanihan:[a-z-]+|[a-z0-9.-]+:[a-z-]+|https?://.+)$",
          "description": "bayanihan:{value-set}, a module namespace, or a URL. Never 'bix'."
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "display": {
          "type": "string"
        }
      },
      "required": [
        "system",
        "code"
      ],
      "additionalProperties": false
    },
    "Quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "box",
            "pack",
            "sack",
            "kg",
            "L",
            "piece",
            "person",
            "person-hour",
            "household",
            "session",
            "PHP"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "Period": {
      "type": "object",
      "properties": {
        "start": {
          "$ref": "#/$defs/dateTime"
        },
        "end": {
          "$ref": "#/$defs/dateTime"
        }
      },
      "additionalProperties": false
    },
    "Attachment": {
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "description": "MIME type."
        },
        "url": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the file."
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "capturedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "showsMinors": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "contentType",
        "url"
      ],
      "additionalProperties": false
    },
    "Identifier": {
      "type": "object",
      "description": "A short reference people can say, e.g. LU 2027-24.",
      "properties": {
        "system": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "Recurrence": {
      "type": "object",
      "properties": {
        "frequency": {
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ]
        },
        "interval": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "byDay": {
          "type": "array",
          "items": {
            "enum": [
              "MO",
              "TU",
              "WE",
              "TH",
              "FR",
              "SA",
              "SU"
            ]
          }
        },
        "until": {
          "$ref": "#/$defs/dateTime"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "frequency"
      ],
      "additionalProperties": false
    },
    "Extension": {
      "type": "object",
      "description": "A namespaced addition. May never redefine a core element.",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "Meta": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "lastUpdated": {
          "$ref": "#/$defs/dateTime"
        },
        "previousHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the previous version's RFC 8785 canonical form."
        },
        "profile": {
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "Sharing": {
      "enum": [
        "private",
        "organization",
        "partners",
        "network",
        "public"
      ]
    },
    "Resource": {
      "type": "object",
      "description": "Elements every BIX resource has.",
      "properties": {
        "resourceType": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        },
        "identifier": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "sharing": {
          "$ref": "#/$defs/Sharing"
        },
        "language": {
          "type": "string",
          "description": "BCP 47, e.g. fil or en. Mixed Filipino-English is fil."
        },
        "extension": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Extension"
          }
        }
      },
      "required": [
        "resourceType",
        "id",
        "meta"
      ]
    },
    "Signature": {
      "type": "object",
      "description": "A group's server or hub signature over a record's RFC 8785 canonical form.",
      "properties": {
        "who": {
          "$ref": "#/$defs/Reference"
        },
        "when": {
          "$ref": "#/$defs/dateTime"
        },
        "algorithm": {
          "enum": [
            "Ed25519"
          ]
        },
        "keyId": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "description": "base64url"
        }
      },
      "required": [
        "who",
        "when",
        "algorithm",
        "keyId",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
