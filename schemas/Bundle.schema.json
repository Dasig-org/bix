{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bix.dasig.org/v0.1/Bundle.schema.json",
  "title": "BIX v0.1 Bundle",
  "x-bix-cae-kind": "transport",
  "type": "object",
  "properties": {
    "resourceType": {
      "const": "Bundle"
    },
    "id": {
      "$ref": "datatypes.schema.json#/$defs/id"
    },
    "type": {
      "enum": [
        "sync",
        "transaction",
        "export"
      ]
    },
    "timestamp": {
      "$ref": "datatypes.schema.json#/$defs/dateTime"
    },
    "entry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fullUrl": {
            "type": "string"
          },
          "resource": {
            "type": "object",
            "required": [
              "resourceType"
            ]
          }
        },
        "required": [
          "fullUrl",
          "resource"
        ]
      }
    }
  },
  "required": [
    "resourceType",
    "id",
    "type",
    "entry"
  ],
  "additionalProperties": false
}
