{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bix.bayanihan.dev/v0.1/Position.schema.json",
  "title": "BIX v0.1 Position",
  "x-bix-cae-kind": "Instrument",
  "type": "object",
  "allOf": [
    {
      "$ref": "datatypes.schema.json#/$defs/Resource"
    }
  ],
  "properties": {
    "resourceType": {
      "const": "Position"
    },
    "id": true,
    "meta": true,
    "identifier": true,
    "sharing": true,
    "language": true,
    "extension": true,
    "organization": {
      "$ref": "datatypes.schema.json#/$defs/Reference"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "board",
        "officer",
        "committee-chair",
        "other"
      ]
    },
    "seats": {
      "type": "integer",
      "minimum": 1
    },
    "term": {
      "type": "string",
      "description": "ISO 8601 duration, e.g. P1Y"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "datatypes.schema.json#/$defs/Coding"
      }
    },
    "requiredBy": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "attachment": {
      "type": "array",
      "items": {
        "$ref": "datatypes.schema.json#/$defs/Attachment"
      }
    }
  },
  "required": [
    "resourceType",
    "id",
    "meta",
    "organization",
    "title"
  ],
  "additionalProperties": false
}
